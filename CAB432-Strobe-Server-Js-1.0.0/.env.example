# SERVER ONLY: controls where the Node API listens.
# This does not change the client Connected API. Use client/.env or the client UI for that.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# AWS region for all SDK clients (Cognito, DynamoDB, S3).
# Reserved by the Lambda runtime when deployed - only needed for local dev.
AWS_REGION=ap-southeast-2

# Cognito - required by src/middleware/auth.js (auth Lambda + any Lambda that authenticates requests)
COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
COGNITO_CLIENT_ID=your-app-client-id

# DynamoDB table names - each Lambda only needs the tables its models touch
DDB_TABLE_USERS=n<id>-ddb-users
DDB_TABLE_POSTS=n<id>-ddb-post
DDB_TABLE_COMMENTS=n<id>-ddb-comments
DDB_TABLE_LIKES=n<id>-ddb-likes
DDB_TABLE_FOLLOWS=n<id>-ddb-follows
DDB_TABLE_MOMENTS=n<id>-ddb-moments

# S3 - required by src/services/uploadService.js and src/utils/enrichment.js (presigned URLs)
S3_MEDIA_BUCKET=n<id>-strobe-media
